# ── Broker ───────────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true

# ── Database (leave blank to use SQLite fallback for local dev) ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=trading
DB_PASSWORD=your_db_password_here

# ── AI ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Notifications ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Data ─────────────────────────────────────────────────────────────────────
FRED_API_KEY=your_fred_api_key_optional

# ── Optional: Fundamentals fallback ──────────────────────────────────────────
FMP_API_KEY=your_fmp_api_key_optional
OPENBB_PAT=your_openbb_personal_access_token_optional
NEWS_API_KEY=your_newsapi_key_optional
