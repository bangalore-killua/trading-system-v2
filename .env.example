# ── Alpaca ───────────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true                          # true = paper trading, false = live

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://killua_trading:your_db_password@localhost:5432/trading_system_v2

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Optional: Fundamentals fallback ──────────────────────────────────────────
# FMP is used as fallback when SEC EDGAR doesn't have what we need (e.g. analyst estimates)
# Free tier: 250 requests/day
FMP_API_KEY=your_fmp_api_key_optional

# ── Optional: OpenBB ─────────────────────────────────────────────────────────
# Provides 33 data providers (Benzinga, FRED, CBOE, SEC, etc.)
# Free tier is sufficient for most providers
OPENBB_PAT=your_openbb_personal_access_token_optional

# ── Optional: News API ───────────────────────────────────────────────────────
# Used as supplementary news source (not primary)
NEWS_API_KEY=your_newsapi_key_optional
